# Wanderlust API — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

PORT=5000
MONGO_URI=your_mongodb_connection_string

# Comma-separated list of browser origins allowed to call the API directly.
CLIENT_ORIGIN=http://localhost:3000,https://my-travel-client.vercel.app

# Shared secret used to verify the short-lived session tokens minted by the
# Next.js server. Must be identical to API_SESSION_SECRET in the client.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_SESSION_SECRET=

# Admin account. The password is stored as a bcrypt hash, never in plain text.
# Generate a hash with:
# node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Optional: only set for a disposable local database used by test/integration.test.js
# The database name must contain "test".
TEST_MONGO_URI=
